#!/usr/local/bin/python
"""/mendel/phase: reports this application's persistent stores and rehearses, applies and withdraws migrations.

The application's only store is its SQLite file. It is found the way the application finds it: the DATABASE_PATH
environment variable, read by pairing_site.config.database_path() (db.connect opens that path). Migrations are the
tool's own: db.migrate() applies numbered SQL files and records each in schema_migrations. Stdout carries only the
JSON documents; everything for a person goes to stderr.

SQLite has no server, no databases beside one another and no grants. A sandbox is therefore a second file in the
folder that holds the application's file, named <name>.db, and the rights it needs are the file system's.
"""

import json
import os
import pwd
import re
import sqlite3
import sys
import tempfile
import urllib.parse

sys.path.insert(0, "/app")

from pairing_site import config, db  # noqa: E402

STORE = "pairing_site"
PREFIX = "mendel_sandbox_"
NAME_RE = r"^[0-9]{3}_[a-z0-9_]+\.sql$"
SANDBOX_NAME_RE = re.compile(r"^" + PREFIX + r"[A-Za-z0-9_-]+$")
REFERENCE = ("schema_migrations",)  # the tool's record of applied migrations: a sandbox needs it whole
SIDE_FILES = ("", "-wal", "-shm", "-journal")


class Failure(Exception):
    pass


CONTRACT = {
    "schema": {
        "type": "object",
        "additionalProperties": False,
        "required": ["up", "down"],
        "properties": {
            "up": {"$ref": "#/$defs/up"},
            "down": {"$ref": "#/$defs/down"},
        },
        "$defs": {
            "up": {
                "type": "object",
                "additionalProperties": False,
                "required": ["name", "sql"],
                "properties": {
                    "name": {"type": "string", "pattern": NAME_RE,
                             "description": "File name of the new migration, a three-digit number then a "
                                            "lower-case name, ending in .sql, as in pairing_site/migrations/."},
                    "sql": {"type": "string",
                            "description": "The SQLite SQL of the migration file: the statements that apply the "
                                           "change."},
                },
            },
            "down": {
                "type": "object",
                "additionalProperties": False,
                "required": ["name", "sql"],
                "properties": {
                    "name": {"type": "string", "pattern": NAME_RE,
                             "description": "The name of the up migration this reverses, exactly as in up."},
                    "sql": {"type": "string",
                            "description": "SQLite SQL statements that reverse everything the up migration's SQL "
                                           "did."},
                },
            },
        },
    },
    "description": (
        "A migration is {up, down}. up is {name, sql}: a new numbered SQL migration file for "
        "pairing_site/migrations/, named like 002_add_something.sql, holding the SQLite SQL that applies the "
        "change. It is run by the application's own migration function, which executes the file's statements in "
        "one transaction and records its name in the schema_migrations table; a name already recorded there is "
        "refused. down is {name, sql}: name repeats the up's name and sql holds statements that reverse the up "
        "completely. They run in one transaction, and then the row for that name is deleted from "
        "schema_migrations so a later apply runs the up again. Nothing is repaired, skipped or retried: "
        "a statement that fails fails the step and SQLite's message is returned."),
    "example": {
        "up": {"name": "002_add_pairings_reviewer_note.sql",
               "sql": "ALTER TABLE pairings ADD COLUMN reviewer_note TEXT;"},
        "down": {"name": "002_add_pairings_reviewer_note.sql",
                 "sql": "ALTER TABLE pairings DROP COLUMN reviewer_note;"},
    },
}


def say(msg):
    print(msg, file=sys.stderr)


def message(exc):
    return str(exc).strip() or exc.__class__.__name__


def production_path():
    return os.path.abspath(config.database_path())


def sandbox_path(name):
    return os.path.join(os.path.dirname(production_path()), name + ".db")


def check_sandbox_name(name):
    """A sandbox is only ever a file called <name>.db beside the application's file."""
    prod = production_path()
    own = {STORE, os.path.basename(prod), os.path.splitext(os.path.basename(prod))[0]}
    if not name.startswith(PREFIX) or name in own or sandbox_path(name) == prod:
        raise Failure("refusing %r: a sandbox name must begin with %s and not be a store of the application"
                      % (name, PREFIX))
    if not SANDBOX_NAME_RE.match(name):
        raise Failure("refusing %r: after %s a sandbox name may only hold letters, digits, _ and -" % (name, PREFIX))
    return sandbox_path(name)


def open_readonly(path):
    uri = "file:%s?mode=ro" % urllib.parse.quote(path)
    conn = sqlite3.connect(uri, uri=True, timeout=db.BUSY_TIMEOUT_S, isolation_level=None)
    conn.row_factory = sqlite3.Row
    return conn


def account():
    try:
        return pwd.getpwuid(os.geteuid()).pw_name
    except KeyError:
        return str(os.geteuid())


def shell_quote(text):
    return "'" + text.replace("'", "'\\''") + "'"


def grant_text(why):
    folder = os.path.dirname(production_path())
    acct = account()
    return ("the account %s cannot do what the sandbox needs (%s). SQLite has no database grants; the right is a "
            "file system one, and POSIX file systems cannot limit it to names. The narrowest grant, to run as root, "
            "is one on the folder that holds the application's file, which is where the sandbox files "
            "(whose names all begin with the literal prefix %s) are created, altered and removed, and on the "
            "application's file, which is only read: "
            "setfacl -m u:%s:rwx %s && setfacl -m u:%s:r %s"
            % (acct, why, PREFIX, acct, shell_quote(folder), acct, shell_quote(production_path())))


def need_rights(read_production=True, write_folder=True):
    prod = production_path()
    folder = os.path.dirname(prod)
    if read_production and not os.access(prod, os.R_OK, effective_ids=True):
        raise Failure(grant_text("it cannot read %s" % prod))
    if write_folder and not os.access(folder, os.W_OK | os.X_OK, effective_ids=True):
        raise Failure(grant_text("it cannot create or remove files in %s" % folder))


def need_production():
    prod = production_path()
    if not os.path.exists(prod):
        raise Failure("the application's database %s does not exist" % prod)
    return prod


def probe():
    prod = production_path()
    if os.path.exists(prod):
        conn = open_readonly(prod)
        try:
            conn.execute("PRAGMA schema_version").fetchone()  # fails unless the file is a database
            version = conn.execute("SELECT sqlite_version()").fetchone()[0]
        finally:
            conn.close()
    else:
        # The application creates the file on its first start; there is nothing to read yet but the engine itself.
        say("phase: %s does not exist yet; the application creates it on first start" % prod)
        conn = sqlite3.connect(":memory:")
        try:
            version = conn.execute("SELECT sqlite_version()").fetchone()[0]
        finally:
            conn.close()
    if not version:
        raise Failure("the engine did not report a version")
    json.dump({"stores": [{"name": STORE, "engine": "sqlite", "version": version, "role": "record"}],
               "migration_contract": CONTRACT}, sys.stdout)
    print()


# ---- describing structure ---------------------------------------------------------------------------------

def tokens(text):
    """(kind, text) pairs of SQL text, kind being word, quoted or punct; blanks and comments are left out."""
    i, n = 0, len(text)
    while i < n:
        ch = text[i]
        if ch.isspace():
            i += 1
        elif text.startswith("--", i):
            j = text.find("\n", i)
            i = n if j < 0 else j + 1
        elif text.startswith("/*", i):
            j = text.find("*/", i + 2)
            i = n if j < 0 else j + 2
        elif ch in "'\"`":
            j = i + 1
            while j < n:
                if text[j] == ch:
                    if j + 1 < n and text[j + 1] == ch:
                        j += 2
                        continue
                    break
                j += 1
            yield "quoted", text[i:j + 1]
            i = j + 1
        elif ch == "[":
            j = text.find("]", i)
            j = n - 1 if j < 0 else j
            yield "quoted", text[i:j + 1]
            i = j + 1
        elif ch.isalnum() or ch == "_":
            j = i
            while j < n and (text[j].isalnum() or text[j] == "_"):
                j += 1
            yield "word", text[i:j]
            i = j
        else:
            yield "punct", ch
            i += 1


def unquote(token):
    if token and token[0] in "'\"`[":
        return token[1:-1].replace(token[0] * 2, token[0]) if token[0] != "[" else token[1:-1]
    return token


def squash(text):
    return re.sub(r"\s+", " ", text).strip()


def check_constraints(create_sql):
    """The CHECK constraints of a CREATE TABLE statement, by name (unnamed ones are check:1, check:2, ...)."""
    toks = list(tokens(create_sql))
    found, i = {}, 0
    while i < len(toks):
        kind, text = toks[i]
        if kind == "word" and text.upper() == "CHECK" and i + 1 < len(toks) and toks[i + 1] == ("punct", "("):
            name = None
            if i >= 2 and toks[i - 2][0] == "word" and toks[i - 2][1].upper() == "CONSTRAINT":
                name = unquote(toks[i - 1][1])
            depth, j, parts = 0, i + 1, []
            while j < len(toks):
                parts.append(toks[j][1])
                depth += (toks[j] == ("punct", "(")) - (toks[j] == ("punct", ")"))
                j += 1
                if depth == 0:
                    break
            expr = " ".join(parts).replace("( ", "(").replace(" )", ")").replace(" ,", ",")
            found[name or "check:%d" % (len(found) + 1)] = "CHECK " + expr
            i = j
        else:
            i += 1
    return found


def quote_ident(name):
    return '"%s"' % name.replace('"', '""')


def describe(conn):
    """The structure of the database the connection is to, the same text every time. Collections are tables and
    views. Besides constraints, a collection's "constraints" lists its triggers as "trigger:<name>", its view
    definition as "view_definition", and each column's nullability, default and generated expression as
    "not_null:<column>", "default:<column>" and "generated:<column>", so that a change to any of them changes the
    text. Columns come in table order, and everything else is ordered by name."""
    out = {}
    conn.execute("BEGIN")
    try:
        objs = conn.execute(
            "SELECT type, name, tbl_name, sql FROM sqlite_master WHERE name NOT LIKE 'sqlite\\_%' ESCAPE '\\' "
            "ORDER BY name COLLATE BINARY").fetchall()
        options = {}
        try:
            for r in conn.execute("PRAGMA table_list"):
                options[(r["schema"], r["name"])] = r
        except sqlite3.DatabaseError:
            pass
        for o in objs:
            if o["type"] not in ("table", "view"):
                continue
            c = {"fields": {}, "identity": [], "indexes": {}, "constraints": {}}
            out[o["name"]] = c
            pk = []
            for col in conn.execute("PRAGMA table_xinfo(%s)" % quote_ident(o["name"])):
                c["fields"][col["name"]] = col["type"]
                if col["pk"]:
                    pk.append((col["pk"], col["name"]))
                if col["notnull"]:
                    c["constraints"]["not_null:" + col["name"]] = "NOT NULL"
                if col["hidden"] in (2, 3):
                    c["constraints"]["generated:" + col["name"]] = "%s: %s" % (
                        "STORED" if col["hidden"] == 3 else "VIRTUAL", squash(col["dflt_value"] or ""))
                elif col["dflt_value"] is not None:
                    c["constraints"]["default:" + col["name"]] = squash(col["dflt_value"])
            c["identity"] = [name for _, name in sorted(pk)]
            if o["type"] == "view":
                c["constraints"]["view_definition"] = squash(o["sql"] or "")
                continue
            opt = options.get(("main", o["name"]))
            if opt is not None:
                if opt["wr"]:
                    c["constraints"]["table_option:without_rowid"] = "WITHOUT ROWID"
                if opt["strict"]:
                    c["constraints"]["table_option:strict"] = "STRICT"
            for name, definition in check_constraints(o["sql"] or "").items():
                c["constraints"][name] = definition
            fks = {}
            for fk in conn.execute("PRAGMA foreign_key_list(%s)" % quote_ident(o["name"])):
                fks.setdefault(fk["id"], []).append(fk)
            for rows in fks.values():
                rows.sort(key=lambda r: r["seq"])
                cols = ", ".join(r["from"] for r in rows)
                refs = ", ".join(r["to"] or "" for r in rows)
                c["constraints"]["foreign_key:" + cols + " -> " + rows[0]["table"]] = (
                    "FOREIGN KEY (%s) REFERENCES %s (%s) ON UPDATE %s ON DELETE %s MATCH %s"
                    % (cols, rows[0]["table"], refs, rows[0]["on_update"], rows[0]["on_delete"], rows[0]["match"]))
            sql_of = {x["name"]: x["sql"] for x in objs if x["type"] == "index"}
            for ix in conn.execute("PRAGMA index_list(%s)" % quote_ident(o["name"])).fetchall():
                if ix["origin"] == "pk":
                    continue
                keys = []
                for k in conn.execute("PRAGMA index_xinfo(%s)" % quote_ident(ix["name"])):
                    if k["key"]:
                        keys.append("%s%s%s" % (k["name"] if k["cid"] >= 0 else "<expression>",
                                                " COLLATE " + k["coll"] if k["coll"] not in (None, "BINARY") else "",
                                                " DESC" if k["desc"] else ""))
                if sql_of.get(ix["name"]):
                    definition = squash(sql_of[ix["name"]])
                else:
                    definition = "%s (%s)" % ("UNIQUE" if ix["unique"] else "INDEX", ", ".join(keys))
                c["indexes"][ix["name"]] = definition
        for o in objs:
            if o["type"] == "trigger" and o["tbl_name"] in out:
                out[o["tbl_name"]]["constraints"]["trigger:" + o["name"]] = squash(o["sql"])
    finally:
        conn.execute("ROLLBACK")
    for c in out.values():  # a stable order for everything that lists several things
        c["constraints"] = dict(sorted(c["constraints"].items()))
        c["indexes"] = dict(sorted(c["indexes"].items()))
    return {"collections": out}


def print_description(path):
    conn = open_readonly(path)
    try:
        doc = describe(conn)
    finally:
        conn.close()
    json.dump(doc, sys.stdout)
    print()


# ---- the sandbox: a file beside the application's, named by the caller ------------------------------------

def remove_files(path):
    try:
        for suffix in SIDE_FILES:
            if os.path.lexists(path + suffix):
                os.unlink(path + suffix)
    except PermissionError:
        raise Failure(grant_text("it cannot remove %s" % path))


def structure(prod):
    """DDL that rebuilds the structure of the database the connection is to (read from sqlite_master, no rows)."""
    rows = prod.execute("SELECT type, name, sql FROM sqlite_master WHERE sql IS NOT NULL "
                        "AND name NOT LIKE 'sqlite\\_%' ESCAPE '\\' ORDER BY rowid").fetchall()
    for r in rows:
        if (r["sql"] or "").lstrip().upper().startswith("CREATE VIRTUAL"):
            raise Failure("cannot copy the structure: %s is a virtual table, which this command does not rebuild"
                          % r["name"])
    order = {"table": 0, "view": 1, "index": 2, "trigger": 3}
    return sorted(rows, key=lambda r: order.get(r["type"], 4))


def sandbox_build(name):
    path = check_sandbox_name(name)
    prod_path = need_production()
    need_rights()
    remove_files(path)
    copied = []
    box = None
    try:
        prod = open_readonly(prod_path)
        try:
            prod.execute("BEGIN")  # one snapshot for the structure and the reference rows
            ddl = structure(prod)
            version = prod.execute("PRAGMA user_version").fetchone()[0]
            box = sqlite3.connect(path, isolation_level=None)
            box.row_factory = sqlite3.Row
            box.execute("BEGIN")
            for r in ddl:
                try:
                    box.execute(r["sql"])
                except sqlite3.Error as e:
                    raise Failure("building the sandbox failed at: %s\n%s" % (r["sql"], message(e)))
            for table in REFERENCE:
                if not prod.execute("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ?",
                                    (table,)).fetchone():
                    continue
                cur = prod.execute("SELECT * FROM %s" % quote_ident(table))
                cols = [d[0] for d in cur.description]
                data = [tuple(r) for r in cur.fetchall()]
                if not data:
                    continue
                box.executemany("INSERT INTO %s (%s) VALUES (%s)" % (
                    quote_ident(table), ", ".join(quote_ident(c) for c in cols), ", ".join("?" * len(cols))), data)
                copied.append({"collection": table, "records": len(data)})
            box.execute("COMMIT")
            box.execute("PRAGMA user_version = %d" % version)
        finally:
            prod.close()
            if box is not None:
                box.close()
    except BaseException:
        remove_files(path)
        raise
    json.dump({"reference_collections": copied}, sys.stdout)
    print()


def sandbox_drop(name):
    path = check_sandbox_name(name)
    remove_files(path)


def need_sandbox(name):
    path = check_sandbox_name(name)
    if not os.path.exists(path):
        raise Failure("there is no sandbox called %s" % name)
    return path


# ---- running one part of a migration -----------------------------------------------------------------------

def read_part():
    part = json.load(sys.stdin)
    if (not isinstance(part, dict) or set(part) != {"name", "sql"} or not isinstance(part["name"], str)
            or not isinstance(part["sql"], str) or not re.match(NAME_RE, part["name"])):
        raise Failure("the part on stdin must be an object with exactly name (like 002_add_x.sql) and sql")
    return part


def run_up(path):
    part = read_part()
    with tempfile.TemporaryDirectory() as d:  # the tool's own function, applying just this file
        with open(os.path.join(d, part["name"]), "w", encoding="utf-8") as f:
            f.write(part["sql"])
        db.MIGRATIONS = d
        applied = db.migrate(path)
    if part["name"] not in applied:
        raise Failure("migration %s is already recorded in schema_migrations; it was not run" % part["name"])


def run_down(path):
    part = read_part()
    with db.session(path, write=True) as conn:
        for statement in db.statements(part["sql"]):
            conn.execute(statement)
        conn.execute("DELETE FROM schema_migrations WHERE name = ?", (part["name"],))


def main(argv):
    cmd, args = (argv[0] if argv else ""), argv[1:]
    try:
        if cmd == "probe" and not args:
            probe()
        elif cmd == "sandbox-build" and len(args) == 1:
            sandbox_build(args[0])
        elif cmd == "sandbox-drop" and len(args) == 1:
            sandbox_drop(args[0])
        elif cmd == "sandbox-describe" and len(args) == 1:
            print_description(need_sandbox(args[0]))
        elif cmd == "sandbox-up" and len(args) == 1:
            run_up(need_sandbox(args[0]))
        elif cmd == "sandbox-down" and len(args) == 1:
            run_down(need_sandbox(args[0]))
        elif cmd == "production-describe" and not args:
            print_description(need_production())
        elif cmd == "production-up" and not args:
            run_up(production_path())
        elif cmd == "production-down" and not args:
            run_down(need_production())
        else:
            say("phase: does not implement: %s" % " ".join(argv))
            return 2
    except (Failure, config.ConfigError, sqlite3.Error, OSError, ValueError) as e:
        say("phase: " + message(e))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
