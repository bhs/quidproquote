#!/usr/local/bin/python
"""/mendel/phase: reports this application's persistent stores and rehearses, applies and withdraws migrations.

The application's only store is its Postgres database. It is found the way the application finds it: the
DATABASE_URL environment variable, read by pairing_site.config.database_url() and opened with
pairing_site.db.connect(). Migrations are the tool's own: db.migrate() applies SQL files and records each in
schema_migrations. Stdout carries only the JSON documents; everything for a person goes to stderr.
"""

import json
import os
import re
import sys
import tempfile

sys.path.insert(0, "/app")

import psycopg  # noqa: E402
from psycopg import sql  # noqa: E402
from psycopg.conninfo import conninfo_to_dict, make_conninfo  # noqa: E402

from pairing_site import config, db  # noqa: E402

STORE = "pairing_site"
PREFIX = "mendel_sandbox_"
NAME_RE = r"^[0-9]{3}_[a-z0-9_]+\.sql$"
REFERENCE = ("schema_migrations",)  # the tool's record of applied migrations: a sandbox needs it whole


class Failure(Exception):
    pass


CONTRACT = {
    "schema": {
        "type": "object",
        "additionalProperties": False,
        "required": ["up", "down"],
        "properties": {
            "up": {"$ref": "#/$defs/up"},
            "down": {"$ref": "#/$defs/down"},
        },
        "$defs": {
            "up": {
                "type": "object",
                "additionalProperties": False,
                "required": ["name", "sql"],
                "properties": {
                    "name": {"type": "string", "pattern": NAME_RE,
                             "description": "File name of the new migration, a three-digit number then a "
                                            "lower-case name, ending in .sql, as in pairing_site/migrations/."},
                    "sql": {"type": "string",
                            "description": "The SQL of the migration file: the statements that apply the change."},
                },
            },
            "down": {
                "type": "object",
                "additionalProperties": False,
                "required": ["name", "sql"],
                "properties": {
                    "name": {"type": "string", "pattern": NAME_RE,
                             "description": "The name of the up migration this reverses, exactly as in up."},
                    "sql": {"type": "string",
                            "description": "SQL statements that reverse everything the up migration's SQL did."},
                },
            },
        },
    },
    "description": (
        "A migration is {up, down}. up is {name, sql}: a new numbered SQL migration file for "
        "pairing_site/migrations/, named like 002_add_something.sql, holding the SQL that applies the change. "
        "It is run by the application's own migration function, which executes the file in one transaction and "
        "records its name in the schema_migrations table; a name already recorded there is refused. "
        "down is {name, sql}: name repeats the up's name and sql holds statements that reverse the up "
        "completely. They run in one transaction, and then the row for that name is deleted from "
        "schema_migrations so a later apply runs the up again. Nothing is repaired, skipped or retried: "
        "a statement that fails fails the step and the database's message is returned."),
    "example": {
        "up": {"name": "002_add_pairings_reviewer_note.sql",
               "sql": "ALTER TABLE pairings ADD COLUMN reviewer_note text;"},
        "down": {"name": "002_add_pairings_reviewer_note.sql",
                 "sql": "ALTER TABLE pairings DROP COLUMN reviewer_note;"},
    },
}


def say(msg):
    print(msg, file=sys.stderr)


def message(exc):
    return (str(exc).strip() or exc.__class__.__name__)


def url():
    return config.database_url()


def url_for(dbname):
    d = conninfo_to_dict(url())
    d["dbname"] = dbname
    return make_conninfo(**d)


def app_database():
    d = conninfo_to_dict(url())
    return d.get("dbname") or d.get("user") or ""


def check_sandbox_name(name):
    if not name.startswith(PREFIX) or name in (STORE, app_database()):
        raise Failure("refusing %r: a sandbox name must begin with %s and not be a store of the application"
                      % (name, PREFIX))
    if len(name.encode()) > 63 or "\x00" in name:
        raise Failure("refusing %r: not a usable database name" % name)


def probe():
    with psycopg.connect(url(), connect_timeout=10, row_factory=db.dict_row) as conn:
        version = conn.execute("SHOW server_version").fetchone()["server_version"]
    if not version:
        raise Failure("the server did not report a version")
    json.dump({"stores": [{"name": STORE, "engine": "postgresql", "version": version, "role": "record"}],
               "migration_contract": CONTRACT}, sys.stdout)
    print()


# ---- describing structure ---------------------------------------------------------------------------------

USER_REL = ("n.nspname NOT IN ('pg_catalog', 'information_schema') AND n.nspname NOT LIKE 'pg\\_toast%' "
            "AND n.nspname NOT LIKE 'pg\\_temp%'")


def describe(conn):
    """The structure of the database the connection is to, the same text every time. Collections are tables,
    views and materialized views (schema-qualified unless in public). Besides constraints, a collection's
    "constraints" lists its triggers as "trigger:<name>", and each column's nullability and default as
    "not_null:<column>" and "default:<column>", so that a change to any of them changes the text."""
    out = {}

    def key(schema, rel):
        return rel if schema == "public" else "%s.%s" % (schema, rel)

    rels = conn.execute(
        "SELECT c.oid, n.nspname AS s, c.relname AS r FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace "
        "WHERE c.relkind IN ('r', 'p', 'v', 'm') AND " + USER_REL + " ORDER BY n.nspname COLLATE \"C\", "
        "c.relname COLLATE \"C\"").fetchall()
    oids = {}
    for r in rels:
        oids[r["oid"]] = key(r["s"], r["r"])
        out[oids[r["oid"]]] = {"fields": {}, "identity": [], "indexes": {}, "constraints": {}}
    for r in conn.execute(
            "SELECT a.attrelid AS o, a.attname AS n, format_type(a.atttypid, a.atttypmod) AS t, a.attnotnull AS nn, "
            "pg_get_expr(d.adbin, d.adrelid) AS dflt FROM pg_attribute a "
            "LEFT JOIN pg_attrdef d ON d.adrelid = a.attrelid AND d.adnum = a.attnum "
            "WHERE a.attnum > 0 AND NOT a.attisdropped AND a.attrelid = ANY(%s) ORDER BY a.attrelid, a.attnum",
            (list(oids),)).fetchall():
        c = out[oids[r["o"]]]
        c["fields"][r["n"]] = r["t"]
        if r["nn"]:
            c["constraints"]["not_null:" + r["n"]] = "NOT NULL"
        if r["dflt"] is not None:
            c["constraints"]["default:" + r["n"]] = r["dflt"]
    for r in conn.execute(
            "SELECT c.conrelid AS o, a.attname AS n FROM pg_constraint c CROSS JOIN LATERAL unnest(c.conkey) WITH ORDINALITY k(num, ord) "
            "JOIN pg_attribute a ON a.attrelid = c.conrelid AND a.attnum = k.num "
            "WHERE c.contype = 'p' AND c.conrelid = ANY(%s) ORDER BY c.conrelid, k.ord", (list(oids),)).fetchall():
        out[oids[r["o"]]]["identity"].append(r["n"])
    for r in conn.execute(
            "SELECT conrelid AS o, conname AS n, pg_get_constraintdef(oid) AS d FROM pg_constraint "
            "WHERE contype NOT IN ('p', 'n') AND conrelid = ANY(%s) ORDER BY conname COLLATE \"C\"",
            (list(oids),)).fetchall():
        out[oids[r["o"]]]["constraints"][r["n"]] = r["d"]
    for r in conn.execute(
            "SELECT tgrelid AS o, tgname AS n, pg_get_triggerdef(oid) AS d FROM pg_trigger "
            "WHERE NOT tgisinternal AND tgrelid = ANY(%s) ORDER BY tgname COLLATE \"C\"", (list(oids),)).fetchall():
        out[oids[r["o"]]]["constraints"]["trigger:" + r["n"]] = r["d"]
    for r in conn.execute(
            "SELECT i.indrelid AS o, ic.relname AS n, pg_get_indexdef(i.indexrelid) AS d FROM pg_index i "
            "JOIN pg_class ic ON ic.oid = i.indexrelid WHERE NOT i.indisprimary AND i.indrelid = ANY(%s) "
            "ORDER BY ic.relname COLLATE \"C\"", (list(oids),)).fetchall():
        out[oids[r["o"]]]["indexes"][r["n"]] = r["d"]
    for c in out.values():  # a stable order for everything that lists several things
        c["constraints"] = dict(sorted(c["constraints"].items()))
        c["indexes"] = dict(sorted(c["indexes"].items()))
    return {"collections": out}


def print_description(conninfo):
    with psycopg.connect(conninfo, connect_timeout=10, row_factory=db.dict_row) as conn:
        conn.execute("SET TRANSACTION READ ONLY")
        doc = describe(conn)
    json.dump(doc, sys.stdout)
    print()


# ---- the sandbox: a database beside production, named by the caller -------------------------------------------

def q(*parts):
    return sql.Identifier(*parts).as_string()


def grant_text(account):
    return ("the account %s lacks the right to create and drop databases. The narrowest grant, to run as a "
            "superuser: ALTER ROLE %s CREATEDB; "
            "(PostgreSQL cannot limit CREATEDB to a name pattern. The role then owns only the databases it "
            "creates, so it may create, alter and drop the tables, columns, indexes, constraints, views, triggers "
            "and sequences inside those and in no other database; this command only ever creates or drops "
            "databases whose names begin with the literal prefix mendel_sandbox_, the underscores being literal.)"
            % (q(account), q(account)))


def admin():
    return psycopg.connect(url(), autocommit=True, connect_timeout=10, row_factory=db.dict_row)


def account(conn):
    return conn.execute("SELECT current_user AS u").fetchone()["u"]


def need_createdb(conn):
    r = conn.execute("SELECT rolcreatedb OR rolsuper AS ok FROM pg_roles WHERE rolname = current_user").fetchone()
    if not (r and r["ok"]):
        raise Failure(grant_text(account(conn)))


def drop_database(conn, name):
    try:
        conn.execute(sql.SQL("DROP DATABASE IF EXISTS {} WITH (FORCE)").format(sql.Identifier(name)))
    except psycopg.errors.InsufficientPrivilege:
        raise Failure(grant_text(account(conn)))


def not_extension(alias, catalog):
    return ("NOT EXISTS (SELECT 1 FROM pg_depend x WHERE x.classid = '%s'::regclass AND x.objid = %s.oid "
            "AND x.deptype = 'e')" % (catalog, alias))


def structure(conn):
    """DDL that rebuilds the structure of the database the connection is to (read from the catalogue, no rows)."""
    stmts = ["SET check_function_bodies = off"]
    for r in conn.execute("SELECT extname FROM pg_extension WHERE extname <> 'plpgsql' ORDER BY extname").fetchall():
        stmts.append("CREATE EXTENSION IF NOT EXISTS " + q(r["extname"]))
    for r in conn.execute(
            "SELECT nspname FROM pg_namespace n WHERE nspname <> 'public' AND " + USER_REL.replace("n.nspname", "nspname")
            + " ORDER BY nspname").fetchall():
        stmts.append("CREATE SCHEMA " + q(r["nspname"]))
    for r in conn.execute(
            "SELECT t.oid, t.typtype, n.nspname AS s, t.typname AS n FROM pg_type t JOIN pg_namespace n ON n.oid = t.typnamespace "
            "LEFT JOIN pg_class c ON c.oid = t.typrelid WHERE " + USER_REL + " AND " + not_extension("t", "pg_type")
            + " AND (t.typtype IN ('e', 'd', 'r', 'm') OR (t.typtype = 'c' AND c.relkind = 'c')) ORDER BY t.oid").fetchall():
        if r["typtype"] != "e":
            raise Failure("cannot copy the structure: %s.%s is a type this command does not rebuild" % (r["s"], r["n"]))
        labels = [x["enumlabel"] for x in conn.execute(
            "SELECT enumlabel FROM pg_enum WHERE enumtypid = %s ORDER BY enumsortorder", (r["oid"],)).fetchall()]
        stmts.append("CREATE TYPE %s AS ENUM (%s)" % (q(r["s"], r["n"]), ", ".join(sql.Literal(x).as_string() for x in labels)))
    if conn.execute(
            "SELECT 1 FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace WHERE p.prokind IN ('a', 'w') AND "
            + USER_REL + " AND " + not_extension("p", "pg_proc") + " LIMIT 1").fetchone():
        raise Failure("cannot copy the structure: the database has aggregate or window functions")
    seqs = conn.execute(
        "SELECT n.nspname AS s, c.relname AS n, sq.seqtypid::regtype::text AS typ, sq.seqstart AS st, sq.seqincrement AS inc, "
        "sq.seqmin AS mn, sq.seqmax AS mx, sq.seqcache AS cache, sq.seqcycle AS cyc, dep.deptype AS dt, "
        "dep.refobjid::regclass::text AS tbl, (SELECT attname FROM pg_attribute WHERE attrelid = dep.refobjid "
        "AND attnum = dep.refobjsubid) AS col FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace "
        "JOIN pg_sequence sq ON sq.seqrelid = c.oid LEFT JOIN pg_depend dep ON dep.classid = 'pg_class'::regclass "
        "AND dep.objid = c.oid AND dep.refclassid = 'pg_class'::regclass AND dep.deptype IN ('a', 'i') "
        "WHERE c.relkind = 'S' AND " + USER_REL + " AND " + not_extension("c", "pg_class") + " ORDER BY c.oid").fetchall()
    owned = []
    for s in seqs:
        if s["dt"] == "i":  # created with its identity column
            continue
        stmts.append("CREATE SEQUENCE %s AS %s START %d INCREMENT %d MINVALUE %d MAXVALUE %d CACHE %d %s"
                     % (q(s["s"], s["n"]), s["typ"], s["st"], s["inc"], s["mn"], s["mx"], s["cache"],
                        "CYCLE" if s["cyc"] else "NO CYCLE"))
        if s["dt"] == "a":
            owned.append("ALTER SEQUENCE %s OWNED BY %s.%s" % (q(s["s"], s["n"]), s["tbl"], q(s["col"])))
    for r in conn.execute(
            "SELECT pg_get_functiondef(p.oid) AS d FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace "
            "WHERE p.prokind IN ('f', 'p') AND " + USER_REL + " AND " + not_extension("p", "pg_proc") + " ORDER BY p.oid").fetchall():
        stmts.append(r["d"])
    rels = conn.execute(
        "SELECT c.oid, c.relkind, c.relpersistence AS pers, c.relispartition AS part, n.nspname AS s, c.relname AS n "
        "FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE c.relkind IN ('r', 'p', 'v', 'm') AND "
        + USER_REL + " AND " + not_extension("c", "pg_class") + " ORDER BY c.oid").fetchall()
    ids = [r["oid"] for r in rels]
    for r in rels:
        if r["relkind"] == "p" or r["part"]:
            raise Failure("cannot copy the structure: %s.%s is partitioned, which this command does not rebuild" % (r["s"], r["n"]))
        if r["relkind"] != "r":
            continue
        cols = []
        for a in conn.execute(
                "SELECT a.attname AS n, format_type(a.atttypid, a.atttypmod) AS t, a.attnotnull AS nn, a.attidentity AS idn, "
                "a.attgenerated AS gen, pg_get_expr(d.adbin, d.adrelid) AS dflt, "
                "CASE WHEN a.attcollation <> t.typcollation THEN co.collname END AS coll, cn.nspname AS collns "
                "FROM pg_attribute a JOIN pg_type t ON t.oid = a.atttypid "
                "LEFT JOIN pg_attrdef d ON d.adrelid = a.attrelid AND d.adnum = a.attnum "
                "LEFT JOIN pg_collation co ON co.oid = a.attcollation LEFT JOIN pg_namespace cn ON cn.oid = co.collnamespace "
                "WHERE a.attrelid = %s AND a.attnum > 0 AND NOT a.attisdropped ORDER BY a.attnum", (r["oid"],)).fetchall():
            c = "%s %s" % (q(a["n"]), a["t"])
            if a["coll"]:
                c += " COLLATE " + q(a["collns"], a["coll"])
            if a["gen"] == "s":
                c += " GENERATED ALWAYS AS (%s) STORED" % a["dflt"]
            elif a["idn"] == "a":
                c += " GENERATED ALWAYS AS IDENTITY"
            elif a["idn"] == "d":
                c += " GENERATED BY DEFAULT AS IDENTITY"
            elif a["dflt"] is not None:
                c += " DEFAULT " + a["dflt"]
            if a["nn"]:
                c += " NOT NULL"
            cols.append(c)
        stmts.append("CREATE %sTABLE %s (%s)" % ("UNLOGGED " if r["pers"] == "u" else "", q(r["s"], r["n"]), ", ".join(cols)))
    cons = conn.execute(
        "SELECT conrelid::regclass::text AS t, conname AS n, contype AS k, pg_get_constraintdef(oid) AS d FROM pg_constraint "
        "WHERE contype IN ('p', 'u', 'c', 'x', 'f') AND conrelid = ANY(%s) ORDER BY (contype = 'f'), oid", (ids,)).fetchall()
    stmts += ["ALTER TABLE %s ADD CONSTRAINT %s %s" % (c["t"], q(c["n"]), c["d"]) for c in cons]
    stmts += owned
    for r in rels:
        if r["relkind"] in ("v", "m"):
            body = conn.execute("SELECT pg_get_viewdef(%s, true) AS d", (r["oid"],)).fetchone()["d"].strip().rstrip(";")
            stmts.append("CREATE %s %s AS %s%s" % ("VIEW" if r["relkind"] == "v" else "MATERIALIZED VIEW",
                                                  q(r["s"], r["n"]), body, "" if r["relkind"] == "v" else " WITH NO DATA"))
    stmts += [r["d"] for r in conn.execute(
        "SELECT pg_get_indexdef(i.indexrelid) AS d FROM pg_index i JOIN pg_class ic ON ic.oid = i.indexrelid "
        "WHERE i.indrelid = ANY(%s) AND NOT EXISTS (SELECT 1 FROM pg_constraint k WHERE k.conindid = i.indexrelid "
        "AND k.contype IN ('p', 'u', 'x') AND k.conrelid = i.indrelid) ORDER BY ic.oid", (ids,)).fetchall()]
    stmts += [r["d"] for r in conn.execute(
        "SELECT pg_get_triggerdef(oid) AS d FROM pg_trigger WHERE NOT tgisinternal AND tgrelid = ANY(%s) ORDER BY oid",
        (ids,)).fetchall()]
    return stmts


def sandbox_build(name):
    check_sandbox_name(name)
    with admin() as a:
        need_createdb(a)
        drop_database(a, name)
        try:
            a.execute(sql.SQL("CREATE DATABASE {}").format(sql.Identifier(name)))
        except psycopg.errors.InsufficientPrivilege:
            raise Failure(grant_text(account(a)))
    copied = []
    with psycopg.connect(url(), connect_timeout=10, row_factory=db.dict_row) as prod:
        prod.isolation_level = psycopg.IsolationLevel.REPEATABLE_READ
        prod.read_only = True
        stmts = structure(prod)
        with psycopg.connect(url_for(name), connect_timeout=10, row_factory=db.dict_row) as box:
            for s in stmts:
                try:
                    box.execute(s)
                except psycopg.Error as e:
                    raise Failure("building the sandbox failed at: %s\n%s" % (s, message(e)))
            for table in REFERENCE:
                if not prod.execute("SELECT to_regclass(%s) AS t", ("public." + table,)).fetchone()["t"]:
                    continue
                cur = prod.execute(sql.SQL("SELECT * FROM public.{}").format(sql.Identifier(table)))
                cols = [c.name for c in cur.description]
                rows = [tuple(r[c] for c in cols) for r in cur.fetchall()]
                if not rows:
                    continue
                with box.cursor() as w:
                    w.executemany(sql.SQL("INSERT INTO public.{} ({}) VALUES ({})").format(
                        sql.Identifier(table), sql.SQL(", ").join(map(sql.Identifier, cols)),
                        sql.SQL(", ").join([sql.Placeholder()] * len(cols))), rows)
                copied.append({"collection": table, "records": len(rows)})
    json.dump({"reference_collections": copied}, sys.stdout)
    print()


def sandbox_drop(name):
    check_sandbox_name(name)
    with admin() as a:
        drop_database(a, name)


# ---- running one part of a migration -----------------------------------------------------------------------

def read_part():
    part = json.load(sys.stdin)
    if (not isinstance(part, dict) or set(part) != {"name", "sql"} or not isinstance(part["name"], str)
            or not isinstance(part["sql"], str) or not re.match(NAME_RE, part["name"])):
        raise Failure("the part on stdin must be an object with exactly name (like 002_add_x.sql) and sql")
    return part


def run_up(conninfo):
    part = read_part()
    with tempfile.TemporaryDirectory() as d:  # the tool's own function, applying just this file
        with open(os.path.join(d, part["name"]), "w", encoding="utf-8") as f:
            f.write(part["sql"])
        db.MIGRATIONS = d
        applied = db.migrate(conninfo)
    if part["name"] not in applied:
        raise Failure("migration %s is already recorded in schema_migrations; it was not run" % part["name"])


def run_down(conninfo):
    part = read_part()
    with db.session(conninfo) as conn:
        conn.execute(part["sql"])
        conn.execute("DELETE FROM schema_migrations WHERE name = %s", (part["name"],))


def main(argv):
    cmd, args = (argv[0] if argv else ""), argv[1:]
    try:
        if cmd == "probe" and not args:
            probe()
        elif cmd == "sandbox-build" and len(args) == 1:
            sandbox_build(args[0])
        elif cmd == "sandbox-drop" and len(args) == 1:
            sandbox_drop(args[0])
        elif cmd in ("sandbox-describe", "sandbox-up", "sandbox-down") and len(args) == 1:
            check_sandbox_name(args[0])
            conninfo = url_for(args[0])
            {"sandbox-describe": print_description, "sandbox-up": lambda c: run_up(c),
             "sandbox-down": lambda c: run_down(c)}[cmd](conninfo)
        elif cmd == "production-describe" and not args:
            print_description(url())
        elif cmd == "production-up" and not args:
            run_up(url())
        elif cmd == "production-down" and not args:
            run_down(url())
        else:
            say("phase: does not implement: %s" % " ".join(argv))
            return 2
    except (Failure, config.ConfigError, psycopg.Error, OSError, ValueError) as e:
        say("phase: " + message(e))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
